@model IEnumerable<Assignment1.Models.Contact>

@{
    ViewBag.Title = "Index";
}


<h2>Contact List</h2>

@Html.ActionLink("Add New", "Create")

<table border="1">
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Email</th>
        <th>Action</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.FirstName</td>
            <td>@item.Email</td>
            <td>@Html.ActionLink("Delete", "Delete", new { id = item.Id })</td>
        </tr>
    }
</table>
